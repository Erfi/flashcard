# Copy to .env — run.sh loads it automatically.
ANTHROPIC_API_KEY=...

# Required if your key is identity-linked (a personal or service-account key that
# is not scoped to one workspace). The API then refuses requests without it.
# Find it in the Console under Settings -> Workspaces, column "ID".
# The Default Workspace is not listed there; its id comes back in the
# "anthropic-workspace-id" response header of any successful request.
# ANTHROPIC_WORKSPACE_ID=...

# Optional: which model writes the cards (default claude-sonnet-5)
# FLASHCARD_MODEL=claude-sonnet-5
